                                <PropertyName>Name</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>FinOpsUri</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>DeployType</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>EnvType</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Track</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Build</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>AppVersion</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>PlatVersion</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>PlatBuild</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>PlatformVersion</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>PpacProvType</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>PpeUri</PropertyName>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
  </ViewDefinitions>
</Configuration>
