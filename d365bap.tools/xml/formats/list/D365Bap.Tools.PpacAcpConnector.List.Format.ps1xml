<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
            <Name>D365Bap.Tools.PpacAcpConnector</Name>
            <ViewSelectedBy>
                <TypeName>D365Bap.Tools.PpacAcpConnector</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem><PropertyName>PolicyId</PropertyName></ListItem>
                            <ListItem><PropertyName>PolicyName</PropertyName></ListItem>
                            <ListItem><PropertyName>ConnectorId</PropertyName></ListItem>
                            <ListItem><PropertyName>ConnectorName</PropertyName></ListItem>
                            <ListItem><PropertyName>AllowedActionsMode</PropertyName></ListItem>
                            <ListItem><PropertyName>AllowedActions</PropertyName></ListItem>
                            <ListItem><PropertyName>AllowedConnectionTypesMode</PropertyName></ListItem>
                            <ListItem><PropertyName>AssignmentSource</PropertyName></ListItem>
                            <ListItem><PropertyName>IsEffective</PropertyName></ListItem>
                            <ListItem><PropertyName>PpacEnvId</PropertyName></ListItem>
                            <ListItem><PropertyName>PpacEnvName</PropertyName></ListItem>
                            <ListItem><PropertyName>EnvironmentGroupId</PropertyName></ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
  </ViewDefinitions>
</Configuration>
