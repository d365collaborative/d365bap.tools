<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
            <Name>D365Bap.Tools.UdePackageModel</Name>
            <ViewSelectedBy>
                <TypeName>D365Bap.Tools.UdePackageModel</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <PropertyName>Package</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Model</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>DisplayName</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Publisher</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>DependsOn</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Dependencies</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>DepLevel</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>ModelPath</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>DescriptorPath</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>AppVersion</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Build</PropertyName>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
  </ViewDefinitions>
</Configuration>
