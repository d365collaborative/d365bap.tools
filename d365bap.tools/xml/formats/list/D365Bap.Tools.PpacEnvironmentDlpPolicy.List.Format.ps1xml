                            </ListItem>
                            <ListItem>
                                <PropertyName>PpacEnvId</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>PpacEnvName</PropertyName>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
  </ViewDefinitions>
</Configuration>
