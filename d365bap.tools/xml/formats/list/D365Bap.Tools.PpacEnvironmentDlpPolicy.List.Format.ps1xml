                            </ListItem>
                            <ListItem>
                                <PropertyName>EnvironmentType</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>DefaultConnectorClassification</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>ConnectorGroupCount</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>ConnectorCount</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>EnvironmentCount</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>EnvironmentIds</PropertyName>
                            </ListItem>
