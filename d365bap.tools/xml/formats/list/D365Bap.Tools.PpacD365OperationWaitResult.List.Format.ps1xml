<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
            <Name>D365Bap.Tools.PpacD365OperationWaitResult</Name>
            <ViewSelectedBy>
                <TypeName>D365Bap.Tools.PpacD365OperationWaitResult</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <PropertyName>EnvironmentName</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>EnvironmentId</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>CorrelationId</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>OperationId</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>OperationName</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Status</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>OperationState</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Success</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>TimedOut</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Duration</PropertyName>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
  </ViewDefinitions>
</Configuration>
