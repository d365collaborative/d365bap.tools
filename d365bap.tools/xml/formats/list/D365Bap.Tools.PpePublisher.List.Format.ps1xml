<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
            <Name>D365Bap.Tools.PpePublisher</Name>
            <ViewSelectedBy>
                <TypeName>D365Bap.Tools.PpePublisher</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem>
                                <PropertyName>Name</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>SystemName</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Prefix</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>OptionValuePrefix</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>PpePublisherId</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>IsReadOnly</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>Description</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>EmailAddress</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>SupportingWebsiteUrl</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>AddressLine1</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>AddressLine2</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>AddressLine3</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>AddressCity</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>AddressStateOrProvince</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>AddressPostalCode</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>AddressCountry</PropertyName>
                            </ListItem>
                            <ListItem>
                                <PropertyName>AddressPhone</PropertyName>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
  </ViewDefinitions>
</Configuration>
