<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>D365Bap.Tools.PpacTenantCapacity</Name>
      <ViewSelectedBy>
        <TypeName>D365Bap.Tools.PpacTenantCapacity</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>CapacityType</Label><Width>26</Width></TableColumnHeader>
          <TableColumnHeader><Label>Total</Label><Width>12</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Base</Label><Width>12</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Incremental</Label><Width>13</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>AddOn</Label><Width>12</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>EntitlementCount</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>LicenseCount</Label><Width>12</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>CapacityType</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Units -eq 'MB') { $n = $_.TotalCapacity; if ($null -eq $n) { '' } elseif ($n -ge 1048576) { '{0:N1} TB' -f ($n / 1048576) } elseif ($n -ge 1024) { '{0:N1} GB' -f ($n / 1024) } else { '{0:N0} MB' -f $n } } else { if ($null -eq $_.TotalCapacity) { '' } else { '{0:N0}' -f $_.TotalCapacity } }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Units -eq 'MB') { $n = $_.BaseCapacity; if ($null -eq $n) { '' } elseif ($n -ge 1048576) { '{0:N1} TB' -f ($n / 1048576) } elseif ($n -ge 1024) { '{0:N1} GB' -f ($n / 1024) } else { '{0:N0} MB' -f $n } } else { if ($null -eq $_.BaseCapacity) { '' } else { '{0:N0}' -f $_.BaseCapacity } }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Units -eq 'MB') { $n = $_.IncrementalCapacity; if ($null -eq $n) { '' } elseif ($n -ge 1048576) { '{0:N1} TB' -f ($n / 1048576) } elseif ($n -ge 1024) { '{0:N1} GB' -f ($n / 1024) } else { '{0:N0} MB' -f $n } } else { if ($null -eq $_.IncrementalCapacity) { '' } else { '{0:N0}' -f $_.IncrementalCapacity } }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Units -eq 'MB') { $n = $_.AddOnCapacity; if ($null -eq $n) { '' } elseif ($n -ge 1048576) { '{0:N1} TB' -f ($n / 1048576) } elseif ($n -ge 1024) { '{0:N1} GB' -f ($n / 1024) } else { '{0:N0} MB' -f $n } } else { if ($null -eq $_.AddOnCapacity) { '' } else { '{0:N0}' -f $_.AddOnCapacity } }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>EntitlementCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>LicenseCount</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
