<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
            <Name>D365Bap.Tools.PpacTenantCapacityLicense</Name>
            <ViewSelectedBy>
                <TypeName>D365Bap.Tools.PpacTenantCapacityLicense</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Width>20</Width></TableColumnHeader>
                    <TableColumnHeader><Width>30</Width></TableColumnHeader>
                    <TableColumnHeader><Width>34</Width></TableColumnHeader>
                    <TableColumnHeader><Width>16</Width></TableColumnHeader>
                    <TableColumnHeader><Width>14</Width></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>CapacityType</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>EntitlementCode</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>DisplayName</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>LicenseTotalCapacity</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>CapabilityStatus</PropertyName></TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
  </ViewDefinitions>
</Configuration>
