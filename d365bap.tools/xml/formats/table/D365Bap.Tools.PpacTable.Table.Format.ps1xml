                            <TableColumnItem>
                                <PropertyName>Name</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Type</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Managed</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Customizable</PropertyName>
                            </TableColumnItem>
